{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senthong",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senthong",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // One Hub instance fans realtime events out to kitchen screens and table phones.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "ratelimits": [
    { "name": "ORDER_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "2002", "simple": { "limit": 6, "period": 60 } },
    { "name": "CALL_LIMITER", "namespace_id": "2003", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": { "DEMO": "1" },
  // 03:00 Asia/Bangkok — wipe and re-seed the public demo every night
  "triggers": { "crons": ["0 20 * * *"] }
}
